    {
      "id": "build",
      "name": "Dograh request बनाओ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        100
      ],
      "parameters": {
        "jsCode": "// App से आया event -> Dograh को जाने वाला payload (कोई secret नहीं).\nconst b = $json.body || {};\nconst c = b.contact || {};\nreturn [{ json: {\n  call_ref: b.call_ref,            // यही call_ref end-of-call webhook में वापस आना चाहिए\n  phone: '+91' + String(c.phone || b.phone || '').replace(/\\D/g, '').slice(-10),\n  variables: {\n    customer_name: c.name || b.name || '',\n    ckey: c.ckey || '',\n    area: c.rate_area || c.area || '',\n    call_ref: b.call_ref,\n    call_reason: b.reason || '',   // Dial Pad का instruction (सिर्फ़ इसी पर बात)\n    language: 'hi',\n    announce_recording: b.announce_recording !== false\n  }\n}}];"
      }
    },
