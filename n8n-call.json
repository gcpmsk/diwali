    {
      "id": "norm",
      "name": "call_completed बनाओ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        460
      ],
      "parameters": {
        "jsCode": "// Dograh end-of-call payload -> app का call_completed.\n// ⚠️ नीचे के field-नाम अपने Dograh workflow के 'extracted variables' के हिसाब से बदलें.\n// Dograh agent को ये 9 outcomes में से EXACTLY एक देना है:\nconst OUT = ['order_placed','rate_enquiry','rate_reduction','callback','not_interested','not_picked','wrong_number','do_not_call','order_update'];\nconst b = $json.body || {};\nconst v = b.gathered_context || b.extracted_variables || b.variables || {};\nconst dur = Number(b.duration || b.call_duration || 0);\nlet outcome = String(v.outcome || b.outcome || '').trim();\nif (!OUT.includes(outcome)) outcome = dur === 0 ? 'not_picked' : 'callback';\nconst items = (v.order_items || b.order_items || []).map(i => ({ name: String(i.name || ''), qty: Number(i.qty) })); // rate कभी नहीं भेजते\nconst payload = {\n  action: 'call_completed',\n  call_ref: v.call_ref || b.call_ref,\n  direction: (b.direction === 'inbound' || b.direction === 'in') ? 'in' : 'out',\n  contact: { phone: b.phone || b.to || b.from || '', ckey: v.ckey || '', name: v.customer_name || '' },\n  outcome,\n  outcome_note: v.outcome_note || v.reason || '',\n  callback_at: v.callback_at || undefined,\n  duration: dur,\n  cost: Number(b.cost || 0),\n  recording_ref: b.recording_id || b.recording_ref || b.recording_url || undefined, // सिर्फ़ reference; app इसे browser को नहीं देती\n  transcript: b.transcript || '',\n  summary: v.summary || b.summary || ''\n};\nif (['order_placed','order_update'].includes(outcome) && items.length) payload.order = { name: v.customer_name || '', items };\nif (outcome === 'rate_reduction') payload.rate_request = { item: v.rate_item || 'Atta Gold', requested_rate: Number(v.requested_rate) };\nreturn [{ json: { APP_URL: $json.APP_URL, payload } }];"
      }
    },
